# Copy to .env and fill in. `.env` is gitignored; this file is not.
#
# Precedence: an EXPORTED variable always wins over a value here, so a one-off override
# needs no file edit (`EVAL_MAX_COST_USD=0.10 make experiment-run ...`). There is a
# self-test pinning that behaviour, because the opposite is a nasty surprise.
#
# Every variable below is read by the code. Nothing is listed aspirationally: a knob that
# reports a value and changes nothing is worse than an absent one, and this project has
# already been bitten by exactly that twice.

# ── reaching models ─────────────────────────────────────────────────────────────────────
# The harness talks to ONE endpoint and lets a gateway fan out to providers: one credential
# here, spend tracked centrally, and the alias -> upstream mapping owned by the proxy
# rather than by 24 config files. Any OpenAI-compatible endpoint works.
LITELLM_BASE_URL=http://127.0.0.1:4001
LITELLM_API_KEY=

# Provider keys, for an adapter that calls a vendor DIRECTLY instead of through the gateway
# (the bundled demo adapter does: it reads whichever key its config's `api_key_env` names,
# defaulting to OPENAI_API_KEY). `make env-check` reports which of these are present.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# ── guards that cost you money if wrong ─────────────────────────────────────────────────
# Per-run ceiling on ACTUAL accumulated spend. When it trips the run stops, keeps partial
# results, and prints a --resume line so nothing is paid for twice.
#
# It does NOT know about any budget your gateway enforces on the key. A sweep here was
# stopped mid-flight by a LiteLLM key budget while this cap still read as headroom — check
# both before a long run.
EVAL_MAX_COST_USD=5.00

# Retries wrap call_system and warmup for every adapter, so a provider blip does not cost
# you a whole arm. Backoff doubles, then flattens at the cap, with jitter. FATAL errors are
# never retried, however friendly their wording ("401 invalid api key, please try again").
EVAL_MAX_RETRIES=8
EVAL_RETRY_MAX_DELAY=60

# ── what a run records about itself ─────────────────────────────────────────────────────
# Identity of the SYSTEM UNDER TEST. Defaults to the git SHA, which is only a default
# because most skeletons start inside a repo. A drop-in often is not — a copied directory,
# a mount, a container — and then the ref is "unknown" and `make validate` refuses the run.
# Set it to whatever identifies your thing: a release, an image digest, a model version.
#   EVAL_BUILD_REF=v2.3.1
#   EVAL_BUILD_REF=sha256:ab12...
EVAL_BUILD_REF=

# Wall-clock is machine-dependent and that is a feature, but auto-detection cannot tell two
# Macs apart. Name the host and the latency column becomes comparable across runs.
#   EVAL_HOST_LABEL=m4pro | mini-intel | dgx
EVAL_HOST_LABEL=

# ── scoping, for when a dataset has grown across config versions ────────────────────────
# Read and write runs somewhere other than data/runs — a smoke pass that must not add
# repeats to a real sweep's arms, or a rescored copy.
# NOTE: it redirects `make validate` too, so unset it before validating.
#   EVAL_RUNS_DIR=data/runs-rescored
EVAL_RUNS_DIR=

# ── slow, optional ──────────────────────────────────────────────────────────────────────
# Hash the actual weight files when fingerprinting a local HF model. Minutes, not seconds;
# worth it when you need to prove two hosts ran identical weights.
#   EVAL_FINGERPRINT_WEIGHTS=1
EVAL_FINGERPRINT_WEIGHTS=

# Where HF models are cached. Only set this if you keep them off the default path.
#   HF_HOME=/mnt/models/huggingface
HF_HOME=
