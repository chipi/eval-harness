{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "judging set",
  "description": "A frozen judging set: data/judging-sets/<judging_set_id>.json, written by judge-score. Which outputs a judge sees, in which blocks and order. judging_set_sha256 is the hash of everything else (V11 checks it).",
  "type": "object",
  "required": ["judging_set_id", "judging_set_sha256", "dataset_id", "dataset_items_sha256", "arms", "protocol", "prompt_sha256_at_16", "items", "position_items", "noise_items"],
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "blocks": {"type": "array", "items": {"type": "array", "minItems": 1, "items": {"type": "string"}}}
  },
  "properties": {
    "judging_set_id": {"type": "string", "pattern": "^.+-[0-9]+arms-[0-9a-f]{12}$"},
    "judging_set_sha256": {"$ref": "#/$defs/sha256"},
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_items_sha256": {"$ref": "#/$defs/sha256"},
    "arms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["config_id", "run", "outputs_sha256"],
        "additionalProperties": false,
        "properties": {
          "config_id": {"type": "string"},
          "run": {"type": "string"},
          "family": {"type": ["string", "null"]},
          "outputs_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "protocol": {
      "type": "object",
      "required": ["outputs_per_call", "blinding", "order_seed", "block_sizes"],
      "additionalProperties": false,
      "properties": {
        "outputs_per_call": {"type": "integer", "minimum": 1},
        "blinding": {"type": "boolean"},
        "order_seed": {"type": "integer"},
        "block_sizes": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}}
      }
    },
    "prompt_sha256_at_16": {"$ref": "#/$defs/sha256"},
    "task": {"type": "object", "description": "The scorer's declared task, when it has one."},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["item_id", "article_sha256", "primary", "position"],
        "additionalProperties": false,
        "properties": {
          "item_id": {"type": "string"},
          "article_sha256": {"$ref": "#/$defs/sha256"},
          "primary": {"$ref": "#/$defs/blocks"},
          "position": {"$ref": "#/$defs/blocks"}
        }
      }
    },
    "position_items": {"type": "array", "items": {"type": "string"}},
    "noise_items": {"type": "array", "items": {"type": "string"}}
  }
}
