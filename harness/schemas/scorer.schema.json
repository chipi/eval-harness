{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "judge scorer",
  "description": "A judge scorer: data/scorers/<scorer_id>.yaml, what judge-score reads. Its file's sha256 is recorded on every judged run, so an edit is a new scorer in effect. V13 adds the checks a schema cannot make (the prompt renders, judge ids are unique).",
  "type": "object",
  "required": ["scorer_id", "kind", "dataset_id", "judges", "prompt", "protocol"],
  "additionalProperties": false,
  "properties": {
    "scorer_id": {"type": "string", "minLength": 1, "description": "Equals the file name."},
    "kind": {"const": "judge"},
    "dataset_id": {"type": "string", "minLength": 1},
    "arms_match": {"type": "string", "description": "The default arm set: a config_id substring."},
    "cost_cap_usd": {"type": "number", "exclusiveMinimum": 0},
    "judges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "params"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "params": {
            "type": "object",
            "required": ["model", "usd_per_mtok_in", "usd_per_mtok_out"],
            "description": "A config's params for the judge model: routed, priced and recorded as an arm's are.",
            "properties": {
              "model": {"type": "string", "minLength": 1},
              "usd_per_mtok_in": {"type": "number", "minimum": 0},
              "usd_per_mtok_out": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    },
    "prompt": {
      "type": "object",
      "required": ["file"],
      "additionalProperties": false,
      "properties": {
        "file": {"type": "string", "minLength": 1, "description": "Relative to the scorer's directory, then the project."},
        "sha256_at_16": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "The prompt rendered for 16 outputs, hashed: the bytes the validation measured."}
      }
    },
    "protocol": {
      "type": "object",
      "required": ["outputs_per_call"],
      "additionalProperties": false,
      "properties": {
        "outputs_per_call": {"type": "integer", "minimum": 1},
        "listwise": {"type": "boolean", "description": "Descriptive: what outputs_per_call > 1 means. Nothing reads it."},
        "blinding": {"type": "boolean"},
        "order_seed": {"type": "integer"},
        "position_check_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "noise_check_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "contested_threshold": {"type": "number", "minimum": 0}
      }
    },
    "task": {
      "type": "object",
      "description": "What is judged, when it is not SummEval's four dimensions on a 1-5 scale.",
      "additionalProperties": false,
      "properties": {
        "dimensions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "scale": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer"}},
        "source_label": {"type": "string"},
        "output_label": {"type": "string"}
      }
    },
    "validation": {
      "type": "object",
      "description": "The measurement that validates these judges for this use. Absent: the scorer is unvalidated and runs only with --unvalidated.",
      "required": ["experiment", "runs"],
      "additionalProperties": false,
      "properties": {
        "experiment": {"type": "string"},
        "what": {"type": "string"},
        "metric": {"type": "string"},
        "min_metric": {"type": "number"},
        "differs_from_this_use": {"type": "string"},
        "runs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["judge", "run", "value"],
            "additionalProperties": false,
            "properties": {
              "judge": {"type": "string"},
              "run": {"type": "string"},
              "value": {"type": "number"},
              "min_metric": {"type": "number"}
            }
          }
        }
      }
    }
  }
}
