{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "judge verdict",
  "description": "One judge call: data/judge-verdicts/<scorer>/<set>/<judge>/<item>.<pass>.b<block>.json, written by judge-score. The stored reply is the evidence a judged score is read from; V12 checks it names a real set, item, pass and block.",
  "type": "object",
  "required": ["set_id", "judge", "judge_fp", "item_id", "pass", "block", "n", "prompt_sha256", "output", "output_sha256", "output_withheld", "scores", "tokens_in", "tokens_out", "cost_usd", "cost_known", "latency_ms", "truncated", "finish_reason", "provider", "response_model", "created_at"],
  "additionalProperties": false,
  "properties": {
    "set_id": {"type": "string"},
    "judge": {"type": "string"},
    "judge_fp": {"type": "string"},
    "item_id": {"type": "string"},
    "pass": {"enum": ["primary", "position", "noise"]},
    "block": {"type": "integer", "minimum": 0},
    "n": {"type": "integer", "minimum": 1, "description": "How many outputs the call judged."},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output": {"type": ["string", "null"], "description": "The judge's reply; null when withheld."},
    "output_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_withheld": {"type": "boolean"},
    "withheld_reason": {"type": "string"},
    "scores": {"type": ["array", "null"], "items": {"type": ["number", "null"]}, "description": "One per output, in block order; null when the reply did not parse."},
    "tokens_in": {"type": ["integer", "null"]},
    "tokens_out": {"type": ["integer", "null"]},
    "cost_usd": {"type": ["number", "null"]},
    "cost_known": {"type": "boolean"},
    "attempts": {"type": "integer", "minimum": 2},
    "cost_usd_earlier_attempts": {"type": "number", "minimum": 0},
    "latency_ms": {"type": ["number", "null"]},
    "truncated": {"type": ["number", "null"]},
    "finish_reason": {"type": ["string", "null"]},
    "provider": {"type": ["string", "null"]},
    "response_model": {"type": ["string", "null"]},
    "created_at": {"type": "string"}
  }
}
