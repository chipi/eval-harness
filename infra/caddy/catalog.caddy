# catalog.evals.humancopilot.eu — the catalog and run inspector of this repository's example
# experiments. Two upstreams: the inspector API (evals-inspector, __INSPECTOR_PORT__) for /api/*,
# the static catalog pages (evals-nginx, __EVALS_PORT__) for everything else. See evals.caddy for
# ownership and the enable-after-DNS rule.
catalog.evals.humancopilot.eu {
	import hardened
	handle /api/* {
		reverse_proxy 127.0.0.1:__INSPECTOR_PORT__
	}
	handle {
		reverse_proxy 127.0.0.1:__EVALS_PORT__
	}
}
