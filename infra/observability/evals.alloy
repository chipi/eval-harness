// evals.alloy — log rules for this repo's `evals-nginx`, `evals-inspector` and `evals-mcp` containers, as a drop-in for the
// prod VPS's shared node Alloy (/opt/vps-observability/config.d/, podcast_scraper ADR-121).
// Installed by infra/deploy/install_alloy.sh (copied from chipi/humancopilot.eu), which validates the WHOLE config.d set with this
// file before installing and rolls back if Alloy refuses the reload.
//
// References components that base.alloy defines (do not redefine them here):
//   discovery.docker "app"  — the Docker-socket container discovery
//   loki.write "logs_sink"  — the VictoriaLogs sink (sets environment/instance)
//   prometheus.remote_write "sink" — the VictoriaMetrics sink
// Everything else is self-contained (like orrery.alloy), so this file deploys independently.
//
// What ships: nginx's one-JSON-line-per-request access log (infra/nginx/nginx.conf `site_json`)
// and its error log, and the inspector's own lines (one per /api/ request, plain text, so they
// pass the json stage unchanged and carry no `site` label). Labels: app=evals; surface=web and
// service=evals-web for nginx, surface=inspector and service=evals-inspector for the inspector
// (`service` is each one's OTel service.name, as LOG-STANDARD has it, so the inspector's logs, its
// traces, its /metrics and its GlitchTip project share one name); `container`; and `site` = the
// request's Host (a handful of domains, so a safe stream label). The edge's view of the same
// requests is already shipped by base.alloy from /var/log/caddy/access.log (job=caddy).

discovery.relabel "evals" {
	targets = discovery.docker.app.targets
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/evals-(nginx|inspector|mcp)"
		action        = "keep"
	}
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(.*)"
		target_label  = "container"
		replacement   = "$1"
	}
	// The surface, and so the service below, per container: nginx serves the web, the inspector is
	// its own service.
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/evals-nginx"
		target_label  = "surface"
		replacement   = "web"
	}
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/evals-inspector"
		target_label  = "surface"
		replacement   = "inspector"
	}
	// The MCP server (0.4.5): one JSON line per tool call (tool, argument names, outcome, ms; never
	// an argument's value or the caller's address).
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/evals-mcp"
		target_label  = "surface"
		replacement   = "mcp"
	}
	// The deployed release (compose label `release: sha-<7>`); loki.process moves it into the
	// `release` field and drops it as a stream label (LOG-STANDARD: one value per deploy, not a
	// stream). Absent on a container started before the label existed.
	rule {
		source_labels = ["__meta_docker_container_label_release"]
		target_label  = "release"
	}
}

loki.source.docker "evals" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.evals.output
	forward_to = [loki.process.evals.receiver]
	labels     = {app = "evals"}
}

loki.process "evals" {
	// Access lines are JSON; error-log lines are not and pass through unchanged.
	stage.json {
		expressions = {site = "host"}
	}
	stage.labels {
		values = {site = ""}
	}
	// level (LOG-STANDARD), only where the line states one: nginx's error log
	// (`2026/10/27 12:00:00 [warn] 29#29: ...`), mapped to debug / info / warning / error /
	// critical. Scoped to those lines, so every other line carries no level at all (absent, not
	// empty); the inspector's lines are access lines with no level.
	stage.match {
		selector = "{container=\"evals-nginx\"} |~ \"^[0-9]{4}/[0-9]{2}/[0-9]{2} [0-9:]{8} \\\\[[a-z]+\\\\]\""

		stage.regex {
			expression = "^\\d{4}/\\d{2}/\\d{2} \\d{2}:\\d{2}:\\d{2} \\[(?P<nginx_level>[a-z]+)\\]"
		}

		stage.template {
			source   = "level"
			template = "{{ if eq .nginx_level \"warn\" }}warning{{ else if or (eq .nginx_level \"crit\") (eq .nginx_level \"alert\") (eq .nginx_level \"emerg\") }}critical{{ else if eq .nginx_level \"notice\" }}info{{ else }}{{ .nginx_level }}{{ end }}"
		}
	}

	stage.structured_metadata {
		values = {level = "", release = ""}
	}
	stage.label_drop {
		values = ["release"]
	}
	forward_to = [loki.relabel.evals_naming.receiver]
}

// service = <app>-<surface>, the homelab LOG-STANDARD key shared with traces and metrics.
loki.relabel "evals_naming" {
	rule {
		source_labels = ["app", "surface"]
		separator     = "-"
		regex         = "(.+-.+)"
		target_label  = "service"
	}
	forward_to = [loki.write.logs_sink.receiver]
}

// The inspector's own metrics (infra/inspector/hooks.py serves /metrics; the harness's --hooks
// route): requests and latency per route and status, its caches, its memory. Scraped on the
// container's bridge IP:8080 like base.alloy's api scrape, so it survives a recreated container;
// Caddy forwards only /catalog/api/ to the inspector, so /metrics is never public. deploy.sh
// installs this file (step 2b) before it recreates the inspector (step 3), so each container's log
// tailer starts under these rules; the scrape reads up=0 for the seconds until the inspector runs.
discovery.relabel "evals_metrics" {
	targets = discovery.docker.app.targets
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/evals-inspector"
		action        = "keep"
	}
	rule {
		source_labels = ["__meta_docker_network_ip_address"]
		regex         = "(.+)"
		target_label  = "__address__"
		replacement   = "${1}:8080"
	}
	rule {
		target_label = "instance"
		replacement  = "prod-podcast"
	}
	rule {
		target_label = "service"
		replacement  = "evals-inspector"
	}
	rule {
		target_label = "namespace"
		replacement  = "evals"
	}
	rule {
		target_label = "environment"
		replacement  = "prod"
	}
}

prometheus.scrape "evals_inspector" {
	targets         = discovery.relabel.evals_metrics.output
	forward_to      = [prometheus.remote_write.sink.receiver]
	job_name        = "evals-inspector"
	metrics_path    = "/metrics"
	scrape_interval = "60s"
}

// The MCP server's metrics (infra/mcp/hooks.py serves /metrics through `evh mcp --hooks`): calls
// per tool and outcome, their latency, Umami events sent, its memory. Scraped like the inspector's;
// Caddy forwards only /mcp to it, so /metrics is never public.
discovery.relabel "evals_mcp_metrics" {
	targets = discovery.docker.app.targets
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/evals-mcp"
		action        = "keep"
	}
	rule {
		source_labels = ["__meta_docker_network_ip_address"]
		regex         = "(.+)"
		target_label  = "__address__"
		replacement   = "${1}:8080"
	}
	rule {
		target_label = "instance"
		replacement  = "prod-podcast"
	}
	rule {
		target_label = "service"
		replacement  = "evals-mcp"
	}
	rule {
		target_label = "namespace"
		replacement  = "evals"
	}
	rule {
		target_label = "environment"
		replacement  = "prod"
	}
}

prometheus.scrape "evals_mcp" {
	targets         = discovery.relabel.evals_mcp_metrics.output
	forward_to      = [prometheus.remote_write.sink.receiver]
	job_name        = "evals-mcp"
	metrics_path    = "/metrics"
	scrape_interval = "60s"
}
