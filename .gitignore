# Repo-root ignores. The harness keeps its own .gitignore for data/, because those paths
# are relative to it and it is meant to be liftable into another project unchanged.
.venv
__pycache__/
*.pyc
.DS_Store

# Secrets: no env file is ever committed, anywhere in the tree. harness/.gitignore covered
# only harness/.env, so a .env beside an example, at the root or named .env.local was
# committable. The templates are the one exception.
.env
.env.*
*.env
!.env.example
!*.env.example

# Each example provisions its own interpreter (uv: pyproject + uv.lock + .python-version),
# so an example cannot bleed into a sibling. The environments themselves are not artifacts.
examples/*/.venv/
examples/*/__pycache__/

# Third-party corpora are referenced by download recipe, never redistributed. Each example
# fetches its own; see examples/*/fetch.py.
examples/*/data/

# Papers. The thirteen under CC BY / CC BY-SA / CC0 ARE committed, with attribution in
# docs/papers/ATTRIBUTION.md as those licences require. The other sixteen are not
# redistributable — twelve arXiv papers carry the non-exclusive licence, which covers
# arXiv and not us, G-Eval is CC BY-NC-ND, two are behind ACM and JSTOR, and one states
# no licence. `fetch_papers.py --all` pulls
# those for reading; this rule stops them being committed by accident.
docs/papers/*.pdf
!docs/papers/lin-2004-rouge.pdf
!docs/papers/conll-2003-ner.pdf
!docs/papers/dror-2018-significance.pdf
!docs/papers/kryscinski-2019-summarization-critique.pdf
!docs/papers/wadden-2020-scifact.pdf
!docs/papers/ding-2021-few-nerd.pdf
!docs/papers/reimers-2019-sentence-bert.pdf
!docs/papers/thakur-2021-beir.pdf
!docs/papers/he-2021-deberta-v3.pdf
!docs/papers/wang-2022-e5.pdf
!docs/papers/zaratiana-2023-gliner.pdf
!docs/papers/zhang-2024-gsm1k.pdf
!docs/papers/yuan-2021-bartscore.pdf

# MkDocs output (mkdocs build); published by .github/workflows/pages.yml, never committed
/build/
